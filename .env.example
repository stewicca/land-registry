# Chain the frontend talks to. Local Hardhat node uses 31337.
VITE_CHAIN_ID=31337

# Read-only JSON-RPC endpoint, used for the public pages so guests need no wallet.
VITE_RPC_URL=http://100.100.143.119:8545

# Comma separated addresses. These two roles have no on-chain registry in the contract.
VITE_AUDITOR_ADDRESSES=
VITE_BANK_ADDRESSES=
# Private key of the account that deploys the contract, and therefore becomes the admin.
# MetaMask shows keys without the 0x prefix; both forms work here. Leave empty to use the node's own accounts.
DEPLOYER_KEY=
